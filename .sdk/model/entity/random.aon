# Entity: random

main: kit: entity: random: {

  alias: field: {}

  fields: [
    {
      name: "author"
      req: false
      short: "The author of the poem"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "linecount"
      req: false
      short: "The number of lines in the poem (including section headings, excluding empty lines)"
      type: "`$INTEGER`"
    }
    {
      name: "lines"
      req: false
      short: "The lines of the poem"
      type: "`$ARRAY`"
    }
    {
      name: "title"
      req: false
      short: "The title of the poem"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "random"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            params: [
              {
                example: 5
                kind: "param"
                name: "count"
                orig: "count"
                reqd: true
                type: "`$INTEGER`"
              }
              {
                example: "author,title"
                kind: "param"
                name: "output_field"
                orig: "output_field"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/random/{count}/{outputFields}"
          rename: {
            param: {
              outputFields: "output_field"
            }
          }
          segments: [
            {
              lit: "random"
            }
            {
              var: "count"
            }
            {
              var: "output_field"
            }
          ]
          select: {
            exist: [
              "count"
              "output_field"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: 5
                kind: "param"
                name: "id"
                orig: "count"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/random/{count}"
          rename: {
            param: {
              count: "id"
            }
          }
          segments: [
            {
              lit: "random"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "random"
      ]
    ]
  }



}
