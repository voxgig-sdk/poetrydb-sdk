# Entity: poemcount

main: kit: entity: poemcount: {

  alias: field: {}

  fields: [
    {
      name: "author"
      req: false
      short: "The author of the poem"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "linecount"
      req: false
      short: "The number of lines in the poem (including section headings, excluding empty lines)"
      type: "`$INTEGER`"
    }
    {
      name: "lines"
      req: false
      short: "The lines of the poem"
      type: "`$ARRAY`"
    }
    {
      name: "title"
      req: false
      short: "The title of the poem"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "poemcount"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: 10
                kind: "param"
                name: "id"
                orig: "count"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/poemcount/{count}"
          rename: {
            param: {
              count: "id"
            }
          }
          segments: [
            {
              lit: "poemcount"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
